+func TestPrelinkCancellationStopsRetriesAndRelay(t *testing.T) {
+	f := newPrelinkFlow(t)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	f.backend = func(_ *http.Request, _ map[string]any, _ int) (*http.Response, error) {
