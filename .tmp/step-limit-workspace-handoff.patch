+)
+
+// Resolve actual wire payloads through this task's receipts, independent of other senders.
+func stepLimitTaskMessages(t *testing.T, h *harness, id uuid.UUID) []telegram.SendMessageRequest {
+	t.Helper()
+	var rows []db.Delivery
+	require.Eventually(t, func() bool {
+		var err error
+		rows, err = h.store.ListOutbox(t.Context(), id)
+		if err != nil || len(rows) == 0 {
+			return false
+		}
+		for _, row := range rows {
+			if row.State != "delivered" {
+				return false
+			}
+		}
+		return true
+	}, 10*time.Second, 20*time.Millisecond)
+	h.peers.mu.Lock()
+	defer h.peers.mu.Unlock()
+	messages := make([]telegram.SendMessageRequest, 0, len(rows))
+	for _, row := range rows {
+		var receipt struct {
+			MessageID int `json:"message_id"`
+		}
+		require.NoError(t, json.Unmarshal(row.Receipt, &receipt))
+		require.Positive(t, receipt.MessageID)
+		require.LessOrEqual(t, receipt.MessageID, len(h.peers.sent))
+		messages = append(messages, h.peers.sent[receipt.MessageID-1])
+	}
+	return messages
+}
+
+func TestStepLimitNotifiesOnceAndAcknowledgesLaterMessages(t *testing.T) {
+	t.Parallel()
+	p := newPeers(t)
+	p.steering = true
+	h := setup(t, p)
+	id := h.submit(t, 201)
+	awaitLoomRun(t, h, id)
+	h.stop(t)
+	pauseMockRun(t, h, id, "step_limit")
+	// Loom can retain an unanswered prompt after reaching the limit.
+	p.mu.Lock()
+	for key, run := range p.runs {
+		run.Question = &loom.Question{ID: "old-question", Text: "Old prompt",
+			Choices: []loom.Choice{{ID: "old", Label: "Old choice"}}, ExpiresAt: time.Now().Add(time.Hour)}
+		p.runs[key] = run
+	}
+	p.mu.Unlock()
+	h.start(t)
+	h.awaitReplies(t, 1)
+	h.await(t, id, "awaiting_service")
+	original, err := h.store.GetTask(context.Background(), id)
+	require.NoError(t, err)
+	require.Empty(t, original.QuestionID)
+
+	h.stop(t)
+	h.start(t)
+	for n, text := range []string{"Continue", "Stop"} {
+		messageID := int64(202 + n)
+		followup := h.submitText(t, messageID, text)
+		h.await(t, followup, "completed")
+		h.awaitReplies(t, n+2)
+		current, getErr := h.store.GetTask(context.Background(), followup)
+		require.NoError(t, getErr)
+		require.Equal(t, original.RunID, current.RunID)
+	}
+	completeMockRun(p)
+	h.await(t, id, "completed")
+	h.awaitReplies(t, 4)
+	h.stop(t)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	require.Len(t, p.runs, 1)
+	require.Empty(t, p.resumeKeys)
+	require.Len(t, p.inputs, 2)
+	require.Equal(t, "Continue", promptUserText(p.inputs[0].Text))
+	require.Equal(t, "Stop", promptUserText(p.inputs[1].Text))
+	for _, message := range p.sent[:3] {
+		require.Contains(t, message.Text, "step limit")
+		require.Contains(t, message.Text, "continue or stop")
+		require.NotContains(t, message.Text, "Old prompt")
+		require.IsType(t, &telegram.ReplyKeyboardMarkup{}, message.ReplyMarkup)
+		keyboard := message.ReplyMarkup.(*telegram.ReplyKeyboardMarkup)
+		require.True(t, keyboard.OneTimeKeyboard)
+		require.Equal(t, [][]telegram.KeyboardButton{{{Text: "Continue"}, {Text: "Stop"}}}, keyboard.Keyboard)
+	}
+	require.Equal(t, "Recovered original run", p.sent[3].Text)
+	require.IsType(t, &telegram.ReplyKeyboardRemove{}, p.sent[3].ReplyMarkup)
+}
