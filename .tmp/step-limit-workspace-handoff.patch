+func TestStepLimitDoesNotReportPauseWhenInputWakesLoom(t *testing.T) {
+	t.Parallel()
+	p := newPeers(t)
+	p.steering, p.wakePausedInput = true, true
+	h := setup(t, p)
+	id := h.submit(t, 211)
+	awaitLoomRun(t, h, id)
+	pauseMockRun(t, h, id, "step_limit")
+	h.awaitReplies(t, 1)
+	p.mu.Lock()
+	choice := p.sent[0].ReplyMarkup.(*telegram.ReplyKeyboardMarkup).Keyboard[0][0].Text
+	p.mu.Unlock()
+	followup := h.submitText(t, 212, choice)
+	h.await(t, followup, "completed")
+	completeMockRun(p)
+	h.await(t, id, "completed")
+	require.Eventually(t, func() bool {
+		p.mu.Lock()
+		defer p.mu.Unlock()
+		return len(p.sent) > 1 && p.sent[len(p.sent)-1].Text == "Recovered original run"
+	}, 5*time.Second, 20*time.Millisecond)
+	h.stop(t)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	for _, message := range p.sent[1:] {
+		require.NotContains(t, message.Text, "continue or stop")
+		_, choices := message.ReplyMarkup.(*telegram.ReplyKeyboardMarkup)
+		require.False(t, choices)
+	}
+	require.Equal(t, choice, promptUserText(p.inputs[0].Text))
+	require.Len(t, p.runs, 1)
+	require.Empty(t, p.resumeKeys)
+}
