+func TestStepLimitNotifiesAgainAfterObservedContinuation(t *testing.T) {
+	t.Parallel()
+	p := newPeers(t)
+	p.steering = true
+	h := setup(t, p)
+	id := h.submit(t, 221)
+	awaitLoomRun(t, h, id)
+	pauseMockRun(t, h, id, "step_limit")
+	h.awaitReplies(t, 1)
+	p.mu.Lock()
+	for key, run := range p.runs {
+		run.Status, run.Reason = "running", ""
+		p.runs[key] = run
+	}
+	p.mu.Unlock()
+	// Keyboard retirement proves ZiNuSya observed the intervening running state.
+	h.awaitReplies(t, 2)
+	p.mu.Lock()
+	require.Equal(t, "The task is no longer paused at the step limit.", p.sent[1].Text)
+	p.mu.Unlock()
+	pauseMockRun(t, h, id, "step_limit")
+	h.awaitReplies(t, 3)
+	completeMockRun(p)
+	h.await(t, id, "completed")
+	h.awaitReplies(t, 4)
+	h.stop(t)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	require.Contains(t, p.sent[0].Text, "step limit")
+	require.Contains(t, p.sent[2].Text, "step limit")
+	require.Len(t, p.runs, 1)
+	require.Empty(t, p.resumeKeys)
+}
