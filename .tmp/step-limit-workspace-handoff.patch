new file mode 100644
index 0000000000000000000000000000000000000000..41ce03447af533f20b5c7d2d1a8d917f3d916cd7
--- /dev/null
+++ b/internal/task/step_limit.go
@@ -0,0 +1,130 @@
+package task
+
+import (
+	"context"
+	"encoding/json"
+	"strconv"
+	"strings"
+
+	"github.com/google/uuid"
+
+	"github.com/complynx/zns-chatbot/internal/db"
+	"github.com/complynx/zns-chatbot/internal/loom"
+	"github.com/complynx/zns-chatbot/internal/telegram"
+)
+
+const (
+	runPaused             = "paused"
+	stepLimitReason       = "step_limit"
+	stepLimitPromptPrefix = "step-limit:"
+)
+
+func stepLimitPaused(run loom.Run) bool {
+	return run.Status == runPaused && run.Reason == stepLimitReason
+}
+
+func (s *Service) pendingStepLimitOutput(
+	ctx context.Context, t *db.Task, c *checkpoint, i intent, run loom.Run,
+) ([]db.Outbound, error) {
+	prompt := stepLimitPromptPrefix + run.ID
+	if c.KeyboardPrompt == prompt {
+		return nil, nil
+	}
+	adopted, err := s.store.HasInputStepLimitNotice(ctx, t.ID, run.ID, run.Version)
+	if err != nil {
+		return nil, err
+	}
+	c.KeyboardRevision++
+	c.KeyboardPrompt = prompt
+	if adopted {
+		return nil, nil
+	}
+	key := prompt + ":presentation:" + strconv.FormatInt(c.KeyboardRevision, 10)
+	return s.stepLimitOutput(ctx, i, key), nil
+}
+
+func (s *Service) stepLimitControlOutput(
+	ctx context.Context, i intent, receipt loom.ControlReceipt,
+) []db.Outbound {
+	if receipt.Status == runPaused && receipt.Reason == stepLimitReason {
+		return s.stepLimitOutput(ctx, i, stepLimitPromptPrefix+receipt.ID)
+	}
+	return nil
+}
+
+func stepLimitKeyboardCurrent(row db.Delivery, run *loom.Run) bool {
+	if run == nil {
+		return false
+	}
+	prefix := row.TaskID.String() + ":" + stepLimitPromptPrefix + run.ID + ":"
+	return stepLimitPaused(*run) && strings.HasPrefix(row.DedupKey, prefix)
+}
+
+// Include receipts without output: a later input may already have woken the run.
+func keyboardRunObservation(state db.KeyboardState, current *loom.Run) (*loom.Run, error) {
+	if current == nil {
+		return current, nil
+	}
+	var receipt *loom.ControlReceipt
+	if err := json.Unmarshal(state.LatestInputReceipt, &receipt); err != nil {
+		return nil, err
+	}
+	run := *current
+	if receipt != nil && receipt.ID == run.ID && receipt.Version > run.Version {
+		run.Status, run.Reason, run.Version = receipt.Status, receipt.Reason, receipt.Version
+		// Receipts do not describe current prompts. Wait for the parent's fresh run read.
+		run.Question, run.Approval = nil, nil
+	}
+	return &run, nil
+}
+
+// A control task may have shown the keyboard before the parent observed the pause.
+func (s *Service) restoreStepLimitKeyboard(ctx context.Context, t db.Task, c *checkpoint) error {
+	if c.KeyboardPrompt != "" || t.TargetTaskID != uuid.Nil || t.RunID == "" {
+		return nil
+	}
+	state, err := s.store.KeyboardState(ctx, t.ID)
+	if err != nil {
+		return err
+	}
+	if state.KeyboardOwnerTaskID == t.ID || state.KeyboardOwnerTaskID == uuid.Nil {
+		return nil
+	}
+	owner, err := s.store.GetTask(ctx, state.KeyboardOwnerTaskID)
+	if err != nil {
+		return err
+	}
+	if owner.TargetTaskID != t.ID || owner.RunID != t.RunID {
+		return nil
+	}
+	var source checkpoint
+	if err = json.Unmarshal(owner.Snapshot, &source); err != nil {
+		return err
+	}
+	if receipt := source.InputReceipt; receipt != nil && receipt.Status == runPaused && receipt.Reason == stepLimitReason {
+		c.KeyboardPrompt = stepLimitPromptPrefix + t.RunID
+	}
+	return nil
+}
+
+// The caller checkpoints each pause presentation; Loom keeps the run and queued inputs.
+func (s *Service) stepLimitOutput(ctx context.Context, i intent, key string) []db.Outbound {
+	ru := s.languageFor(ctx, i) == "ru"
+	text := structuredText(ru,
+		"I reached the step limit and the task is paused. Would you like to continue or stop? "+
+			"Choose Continue or Stop below, or write your answer. "+
+			"Some actions may already have completed; stopping will not undo them.",
+		"Я достигла лимита шагов, и задача приостановлена. Продолжить работу или прекратить? "+
+			"Выбери «Продолжить» или «Прекратить» ниже либо напиши ответ. "+
+			"Часть действий могла уже выполниться; остановка их не отменит.",
+	)
+	out := s.result(i, text, key)
+	setReplyMarkup(out, &telegram.ReplyKeyboardMarkup{
+		Keyboard: [][]telegram.KeyboardButton{{
+			{Text: structuredText(ru, "Continue", "Продолжить")},
+			{Text: structuredText(ru, "Stop", "Прекратить")},
+		}},
+		ResizeKeyboard: true, OneTimeKeyboard: true,
+	})
+	return out
+}
