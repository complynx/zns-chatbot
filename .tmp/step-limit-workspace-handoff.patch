+func TestStepLimitKeyboardUsesFreshReceiptAndRetiresDelayedDelivery(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		name     string
+		question bool
+		terminal string
+	}{{"cancelled running parent", false, "cancelled"}, {"completed parent with choices", true, "completed"}} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			p := newPeers(t)
+			p.steering, p.question = true, test.question
+			p.questionChoices = []loom.Choice{{ID: "old", Label: "Old choice"}}
+			p.miniAppOrigin = appTestOrigin
+			h := setup(t, p)
+			seedNamedTelegramUser(t, h)
+			id := h.submit(t, 231)
+			if test.question {
+				h.await(t, id, "awaiting_user")
+				h.awaitReplies(t, 1)
+			} else {
+				awaitLoomRun(t, h, id)
+			}
+			h.stop(t)
+			// Freeze only the parent's observation; input tasks still use the real worker path.
+			const holdTask = `UPDATE shuttle_tasks
+ SET lease_owner='paused-test-task',lease_until=clock_timestamp()+interval '1 hour' WHERE id=$1`
+			const releaseTask = "UPDATE shuttle_tasks SET lease_owner='',lease_until=NULL WHERE id=$1"
+			_, err := h.store.Pool().Exec(t.Context(), holdTask, id)
+			require.NoError(t, err)
+			pauseMockRun(t, h, id, "step_limit")
+			h.start(t)
+			fresh := h.submitText(t, 232, "Continue")
+			h.await(t, fresh, "completed")
+			require.Equal(t, "Continue", replyChoice(t, p, h, fresh))
+			if test.question {
+				_, err = h.store.Pool().Exec(t.Context(), releaseTask, id)
+				require.NoError(t, err)
+				h.await(t, id, "awaiting_service")
+				rows, readErr := h.store.ListOutbox(t.Context(), id)
+				require.NoError(t, readErr)
+				require.Len(t, rows, 1, "The parent adopts the input notice instead of sending another")
+				h.stop(t)
+				_, err = h.store.Pool().Exec(t.Context(), holdTask, id)
+				require.NoError(t, err)
+				h.start(t)
+			}
+			menu := h.submitText(t, 233, "/menu")
+			h.await(t, menu, "completed")
+			menuMessages := stepLimitTaskMessages(t, h, menu)
+			require.Nil(t, menuMessages[0].ReplyMarkup, "The menu must preserve the fresh pause choices")
+			p.mu.Lock()
+			p.rejectSendOnce = true
+			p.mu.Unlock()
+			delayed := h.submitText(t, 234, "Stop")
+			require.Eventually(t, func() bool {
+				rows, readErr := h.store.ListOutbox(t.Context(), delayed)
+				return readErr == nil && len(rows) == 1 && rows[0].State == "retryable"
+			}, 5*time.Second, 20*time.Millisecond)
+			h.stop(t)
+			_, err = h.store.Pool().Exec(t.Context(), holdTask, delayed)
+			require.NoError(t, err)
+			p.mu.Lock()
+			p.wakePausedInput = true
+			p.mu.Unlock()
+			h.start(t)
+			wake := h.submitText(t, 235, "Continue")
+			h.await(t, wake, "completed")
+			menu = h.submitText(t, 236, "/menu")
+			h.await(t, menu, "completed")
+			menuMessages = stepLimitTaskMessages(t, h, menu)
+			require.IsType(t, &telegram.ReplyKeyboardRemove{}, menuMessages[0].ReplyMarkup,
+				"An outputless wake receipt must allow the menu to retire pause choices")
+			_, err = h.store.Pool().Exec(t.Context(), releaseTask, delayed)
+			require.NoError(t, err)
+			delayedMessages := stepLimitTaskMessages(t, h, delayed)
+			require.Nil(t, delayedMessages[0].ReplyMarkup, "The delayed notice must not reinstall retired buttons")
+			p.mu.Lock()
+			for key, run := range p.runs {
+				run.Status, run.Result = test.terminal, "Recovered original run"
+				run.Version++
+				p.runs[key] = run
+			}
+			p.mu.Unlock()
+			_, err = h.store.Pool().Exec(t.Context(), releaseTask, id)
+			require.NoError(t, err)
+			h.await(t, id, test.terminal)
+			terminalMessages := stepLimitTaskMessages(t, h, id)
+			require.IsType(t, &telegram.ReplyKeyboardRemove{}, terminalMessages[len(terminalMessages)-1].ReplyMarkup)
+			h.stop(t)
+		})
+	}
+}
