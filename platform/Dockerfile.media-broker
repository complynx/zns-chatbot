FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /mediaworker ./cmd/mediaworker
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -g 10002 media && adduser -D -u 10002 -G media broker && mkdir -p /run/media-ipc && chown 10002:10002 /run/media-ipc && chmod 0700 /run/media-ipc
USER 10002:10002
COPY --from=build /mediaworker /usr/local/bin/mediaworker
ENV MEDIA_WORKER_MODE=broker
EXPOSE 8091
ENTRYPOINT ["mediaworker"]

