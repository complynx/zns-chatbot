[Unit]
Description=ZNS exclusive application and helper owner
Wants=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
UMask=0077
EnvironmentFile=/etc/zns/replacement.env
ExecStart=/usr/local/bin/znsreplace /etc/zns/replacement.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
