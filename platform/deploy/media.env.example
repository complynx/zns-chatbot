# MEDIA_WORKER_SECRET must equal app.env ZNS_MEDIA__SECRET.
MEDIA_WORKER_SECRET=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
DATABASE_URL=postgres://zns_meter:REPLACE_WITH_ACCOUNTING_PASSWORD@postgres/zns?sslmode=disable
# Must equal runtime.yaml credits.enforce. Paid ASR without a reviewed bound fails closed.
ZNS_CREDITS__ENFORCE=false
